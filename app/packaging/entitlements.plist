<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened-runtime entitlements for a frozen-Python app.
       A PyInstaller bundle loads many third-party dylibs not signed by our
       team, and CPython allocates executable memory, so the two relaxations
       below are required for the hardened runtime to launch it. The app makes
       outbound network requests (to Anthropic) and spawns local subprocesses
       (the claude CLI, karospace) — both allowed without extra entitlements. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
